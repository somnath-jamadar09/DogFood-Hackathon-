# Dogfood 2026 - Environmental Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/dogfood

# Microservices
JUDGING_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=raptors-offline-cryptographic-master-key-2026
JWT_EXPIRES_IN=1h
REFRESH_SECRET=raptors-refresh-token-secret-salt-2026
REFRESH_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
